# Application
VITE_APP_TITLE=Y-Plaza

# Backend API
VITE_API_BASE_URL=http://localhost:3001/api/v1

# CDN for uploaded images (defaults to VITE_API_BASE_URL without /api/v1)
# VITE_CDN_BASE_URL=http://localhost:3001

# Enable mock data when backend is unavailable
VITE_USE_MOCK=false

# Background images (comma-separated Unsplash URLs)
VITE_BACKGROUND_IMAGES=https://images.unsplash.com/photo-1564013799919-ab600027ffc6?w=1920&q=85,https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?w=1920&q=85,https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=1920&q=85,https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?w=1920&q=85

# Google OAuth
VITE_GOOGLE_CLIENT_ID=your-google-client-id
